{
  // The SDK is published code, so it stays strict where the rest of garden is not.
  // Garden's base sets the individual strict flags to false explicitly, which
  // `strict: true` alone would not override.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true
  }
}
