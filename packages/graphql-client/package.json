{
  "name": "@ver-id/graphql-client",
  "version": "0.14.0",
  "description": "Ver.iD GraphQL client for querying the Ver.iD platform API",
  "license": "MIT",
  "author": "Ver.iD",
  "homepage": "https://github.com/ver-id/verid-sdk-js-mono/tree/main/packages/graphql-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ver-id/verid-sdk-js-mono.git",
    "directory": "packages/graphql-client"
  },
  "bugs": {
    "url": "https://github.com/ver-id/verid-sdk-js-mono/issues"
  },
  "keywords": [
    "verid",
    "ver-id",
    "graphql",
    "apollo",
    "decentralized-identity",
    "did",
    "verifiable-credentials",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@monorepov2/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "*.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/near-operation-file-preset": "^5.0.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "graphql": "^16.13.1",
    "tsup": "^8.5.1"
  },
  "nx": {
    "tags": [
      "scope:sdk"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsup",
          "cwd": "{projectRoot}"
        }
      },
      "codegen": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "@ver.id/libs.schemas.adam"
            ],
            "target": "codegen"
          }
        ],
        "options": {
          "commands": [
            "graphql-codegen --config codegen.ts",
            "find src/operations -name '*.gql.ts' -exec node scripts/fix-imports.mjs {} \\;"
          ],
          "parallel": false,
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@ver-id/core": "^0.3.0"
  }
}
