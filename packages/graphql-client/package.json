{
  "name": "@ver-id/graphql-client",
  "version": "0.7.0",
  "description": "Ver.iD GraphQL client for querying the Ver.iD platform API",
  "license": "MIT",
  "author": "Ver.iD",
  "homepage": "https://github.com/ver-id/verid-sdk-js-mono/tree/main/packages/graphql-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ver-id/verid-sdk-js-mono.git",
    "directory": "packages/graphql-client"
  },
  "bugs": {
    "url": "https://github.com/ver-id/verid-sdk-js-mono/issues"
  },
  "keywords": [
    "verid",
    "ver-id",
    "graphql",
    "apollo",
    "decentralized-identity",
    "did",
    "verifiable-credentials",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@verid-sdk-js-mono/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "*.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "codegen"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsup",
          "cwd": "packages/graphql-client"
        }
      },
      "codegen": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "graphql-codegen --config codegen.ts",
            "find src/operations -name '*.gql.ts' -exec node scripts/fix-imports.mjs {} \\;"
          ],
          "parallel": false,
          "cwd": "packages/graphql-client"
        }
      }
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "graphql": "^16.11.0"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@graphql-typed-document-node/core": "^3.2.0"
  }
}
