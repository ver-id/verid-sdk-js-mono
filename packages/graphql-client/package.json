{
  "name": "@ver-id/graphql-client",
  "version": "0.6.3",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@verid-sdk-js-mono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "codegen"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsup",
          "cwd": "packages/graphql-client"
        }
      },
      "codegen": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "graphql-codegen --config codegen.ts",
            "find src/operations -name '*.gql.ts' -exec node scripts/fix-imports.mjs {} \\;"
          ],
          "parallel": false,
          "cwd": "packages/graphql-client"
        }
      }
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "graphql": "^16.11.0"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@graphql-typed-document-node/core": "^3.2.0"
  }
}
