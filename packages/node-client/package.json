{
  "name": "@ver-id/node-client",
  "version": "0.13.1",
  "description": "Ver.iD Node.js SDK for decentralized identity authentication, disclosure, and issuance flows",
  "license": "MIT",
  "author": "Ver.iD",
  "homepage": "https://github.com/ver-id/verid-sdk-js-mono/tree/main/packages/node-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ver-id/verid-sdk-js-mono.git",
    "directory": "packages/node-client"
  },
  "bugs": {
    "url": "https://github.com/ver-id/verid-sdk-js-mono/issues"
  },
  "keywords": [
    "verid",
    "ver-id",
    "decentralized-identity",
    "did",
    "verifiable-credentials",
    "oauth2",
    "authentication",
    "disclosure",
    "issuance",
    "node",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@verid-sdk-js-mono/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "*.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": ">=3.0.0",
    "@aws-sdk/lib-dynamodb": ">=3.0.0",
    "ioredis": ">=5.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsup",
          "cwd": "packages/node-client"
        }
      }
    }
  }
}
