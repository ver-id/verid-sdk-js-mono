{
  "name": "@ver-id/browser-client",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@verid-sdk-js-mono/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/browser-client/dist",
          "main": "packages/browser-client/src/index.ts",
          "tsConfig": "packages/browser-client/tsconfig.lib.json",
          "format": [
            "esm",
            "cjs"
          ],
          "declarationRootDir": "packages/browser-client/src"
        }
      }
    }
  },
  "dependencies": {}
}
