{
  "name": "@ver-id/embedded-browser-client",
  "version": "0.1.0",
  "description": "Ver.iD embedded-mode browser SDK: mounts the Ver.iD iframe and surfaces the flow lifecycle as typed events",
  "license": "MIT",
  "author": "Ver.iD",
  "homepage": "https://github.com/ver-id/verid-sdk-js-mono/tree/main/packages/embedded-browser-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ver-id/verid-sdk-js-mono.git",
    "directory": "packages/embedded-browser-client"
  },
  "bugs": {
    "url": "https://github.com/ver-id/verid-sdk-js-mono/issues"
  },
  "keywords": [
    "verid",
    "ver-id",
    "decentralized-identity",
    "did",
    "verifiable-credentials",
    "oauth2",
    "authentication",
    "disclosure",
    "issuance",
    "embedded",
    "browser",
    "sdk"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@verid-sdk-js-mono/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "*.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ver-id/core": "workspace:^"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsup",
          "cwd": "packages/embedded-browser-client"
        }
      }
    }
  }
}
