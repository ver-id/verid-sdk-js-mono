# Ver.iD Authentication Configuration
VITE_VERID_AUTHENTICATION_API_URL=https://ssi.oauth.ver.id
VITE_VERID_AUTHENTICATION_FLOW_ID=<YOUR_AUTHENTICATION_FLOW_ID>
VITE_VERID_AUTHENTICATION_REDIRECT_URI=http://localhost:4200/authentication/browser/callback
VITE_VERID_AUTHENTICATION_SCOPES=profile

# Ver.iD Disclosure Configuration
VITE_VERID_DISCLOSURE_API_URL=https://ssi.oauth.ver.id
VITE_VERID_DISCLOSURE_FLOW_ID=<YOUR_DISCLOSURE_FLOW_ID>
VITE_VERID_DISCLOSURE_REDIRECT_URI=http://localhost:4200/disclosure/browser/callback

# Ver.iD Issuance Configuration
VITE_VERID_ISSUANCE_API_URL=https://ssi.oauth.ver.id
VITE_VERID_ISSUANCE_FLOW_ID=<YOUR_ISSUANCE_FLOW_ID>
VITE_VERID_ISSUANCE_REDIRECT_URI=http://localhost:4200/issuance/browser/callback

# Ver.iD GraphQL Configuration
VITE_VERID_GRAPHQL_ENDPOINT=https://graphql.ver.id
VITE_VERID_GRAPHQL_AUTHORIZATION_SERVER=https://api.oauth.ver.id
VITE_VERID_GRAPHQL_CLIENT_ID=<YOUR_CLIENT_ID>
VITE_VERID_GRAPHQL_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# Backend Server Configuration
VITE_NODE_SERVER_URL=http://localhost:3000

# Ver.iD Embedded Configuration
# Embedded flows are registered in Studio WITHOUT a redirect URI. These ids only
# pre-fill the demo config form — the authoritative values live on the server,
# along with the webhook secrets. See the sample-node-server .env.example.
VITE_VERID_EMBEDDED_AUTHENTICATION_FLOW_ID=<YOUR_EMBEDDED_AUTHENTICATION_FLOW_ID>
VITE_VERID_EMBEDDED_DISCLOSURE_FLOW_ID=<YOUR_EMBEDDED_DISCLOSURE_FLOW_ID>
VITE_VERID_EMBEDDED_ISSUANCE_FLOW_ID=<YOUR_EMBEDDED_ISSUANCE_FLOW_ID>