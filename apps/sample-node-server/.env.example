# Server Configuration
HOST=localhost
PORT=3000

# Ver.iD Authentication Configuration
VERID_AUTHENTICATION_API_URL=https://ssi.oauth.ver.id
VERID_AUTHENTICATION_FLOW_ID=<YOUR_AUTHENTICATION_FLOW_ID>
VERID_AUTHENTICATION_REDIRECT_URI=http://localhost:3000/api/authentication/callback

# Ver.iD Disclosure Configuration
VERID_DISCLOSURE_API_URL=https://ssi.oauth.ver.id
VERID_DISCLOSURE_FLOW_ID=<YOUR_DISCLOSURE_FLOW_ID>
VERID_DISCLOSURE_REDIRECT_URI=http://localhost:3000/api/disclosure/callback

# Ver.iD Issuance Configuration
VERID_ISSUANCE_API_URL=https://ssi.oauth.ver.id
VERID_ISSUANCE_FLOW_ID=<YOUR_ISSUANCE_FLOW_ID>
VERID_ISSUANCE_REDIRECT_URI=http://localhost:3000/api/issuance/callback

VERID_CLIENT_SECRET=<YOUR_CLIENT_SECRET>
FRONTEND_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Ver.iD Embedded Configuration
# ---------------------------------------------------------------------------
# Embedded flows run inside an iframe instead of a full-page redirect. They are
# registered in Ver.iD Studio WITHOUT a redirect URI, and the authorization code
# is delivered to this server on a signed, server-to-server webhook.

# Public base URL that the Ver.iD platform can reach THIS server on.
# Because the webhook is a server-to-server call, localhost will never work.
#
#   Garden (local cluster): wildcard DNS resolves your profile host to your dev
#     machine from inside the cluster, so you can point straight at it:
#       VERID_WEBHOOK_PUBLIC_URL=http://<profile>.ver.garden:3000
#     Note: set HOST=0.0.0.0 above, otherwise the server only listens on
#     127.0.0.1 and the cluster cannot reach it.
#   Everyone else: run a tunnel and paste its public URL:
#       cloudflared tunnel --url http://localhost:3000
#       ngrok http 3000
VERID_WEBHOOK_PUBLIC_URL=

# Embedded flow ids. A flow carries BOTH delivery configs, so these may be the
# same flows used for redirect mode above. For embedded the flow additionally
# needs an allowedEmbedOrigin (your page) and a registered webhook URI.
VERID_EMBEDDED_AUTHENTICATION_FLOW_ID=<YOUR_EMBEDDED_AUTHENTICATION_FLOW_ID>
VERID_EMBEDDED_DISCLOSURE_FLOW_ID=<YOUR_EMBEDDED_DISCLOSURE_FLOW_ID>
VERID_EMBEDDED_ISSUANCE_FLOW_ID=<YOUR_EMBEDDED_ISSUANCE_FLOW_ID>

# Per-flow HMAC webhook secrets from Ver.iD Studio (used to verify
# x-signature-256). Garden dev seeds use a well-known shared value:
#   webhook-demo-secret-for-local-development
VERID_EMBEDDED_AUTHENTICATION_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>
VERID_EMBEDDED_DISCLOSURE_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>
VERID_EMBEDDED_ISSUANCE_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>

# Optional: override the Ronan embed URL handed to the browser.
# Defaults to the issuerUri origin when empty. In Garden, Ronan is served on the
# gateway subhost, separate from the OAuth issuer:
#   VERID_RONAN_URI=https://gateway.<profile>.ver.garden:13370
VERID_RONAN_URI=

# Optional: how long a finalized embedded result stays pollable (ms, default 10m)
VERID_EMBEDDED_RESULT_TTL_MS=

# Optional: override the OAuth scope string sent with each embedded flow.
# Authentication REQUIRES openid plus at least one other scope — `openid` alone
# is rejected by the OAuth server. Disclosure and issuance are top-level scopes.
VERID_EMBEDDED_AUTHENTICATION_SCOPES=openid profile
VERID_EMBEDDED_DISCLOSURE_SCOPES=disclosure
VERID_EMBEDDED_ISSUANCE_SCOPES=issuance
